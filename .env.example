# AI×Design Newsletter Generator - Environment Configuration

# Claude API Configuration
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_api_key_here

# API Settings
CLAUDE_MODEL=claude-sonnet-4-20250514
API_TIMEOUT=60
MAX_RETRIES=3

# Content Fetching
MAX_CONTENT_LENGTH=10000
FETCH_TIMEOUT=30
USER_AGENT=Mozilla/5.0 (compatible; AI-Design-Newsletter-Bot/1.0)

# Database
DATABASE_PATH=data/links.db

# Output Settings
DEFAULT_OUTPUT_DIR=output
DEFAULT_FORMAT=markdown

# Feature Flags
USE_AI_ANALYSIS=true           # Set to false to disable AI features
USE_MOCK_DATA=false            # Set to true for testing without API calls

# Social Media
TWITTER_HANDLE=@your_handle
WECHAT_NAME=Your WeChat Name
XIAOHONGSHU_ID=Your XiaoHongShu ID
