<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }}</title>
</head>
<body>
<section style="font-size: 16px; color: rgb(62, 62, 62); font-family: -apple-system-font, system-ui, 'Helvetica Neue', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei UI', 'Microsoft YaHei', Arial, sans-serif; letter-spacing: 0.544px; text-align: justify; white-space: normal; background-color: rgb(255, 255, 255); line-height: 1.75em; box-sizing: border-box;">

<!-- 标题 -->
<section style="margin: 20px auto; text-align: center;">
    <h1 style="font-size: 24px; color: #2c3e50; font-weight: bold; margin-bottom: 10px;">
        {{ title }}
    </h1>
</section>

<!-- 导语 -->
<section style="margin: 15px 8px; padding: 15px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border-radius: 8px; box-shadow: 0 3px 10px rgba(0,0,0,0.1);">
    <p style="color: white; font-size: 15px; line-height: 1.8; margin: 0; text-align: center;">
        {{ intro }}
    </p>
</section>

<!-- 本周概览 -->
<section style="margin: 20px 8px; padding: 15px; background-color: #f7f9fc; border-left: 4px solid #4CAF50; border-radius: 4px;">
    <h2 style="font-size: 18px; color: #2c3e50; margin: 0 0 10px 0;">
        📊 本周概览
    </h2>
    <p style="font-size: 14px; line-height: 1.8; margin: 5px 0; color: #555;">
        📌 收录链接：<strong>{{ total_links }}</strong> 条<br>
        📌 核心主题：{{ ', '.join(main_topics) }}<br>
        📌 推荐指数：{{ '⭐' * recommendation_score }}
    </p>
</section>

<!-- 内容分类 -->
{% for category in categories %}
{% if category.content_items %}
<section style="margin: 25px 8px;">
    <h2 style="font-size: 18px; color: #2c3e50; border-bottom: 2px solid #4CAF50; padding-bottom: 8px; margin-bottom: 15px;">
        {{ category.icon }} {{ category.name }}
    </h2>

    {% for item in category.content_items %}
    <section style="margin-bottom: 20px; padding: 12px; background-color: #fafafa; border-radius: 6px; border-left: 3px solid #4CAF50;">
        <h3 style="font-size: 16px; color: #34495e; margin: 0 0 8px 0; font-weight: bold;">
            {{ item.title }}
        </h3>
        <p style="font-size: 14px; color: #666; line-height: 1.6; margin: 8px 0;">
            {{ item.summary }}
        </p>
        {% if item.tags %}
        <p style="margin: 8px 0;">
            {% for tag in item.tags %}
            <span style="display: inline-block; background-color: #e3f2fd; color: #1976d2; padding: 2px 8px; border-radius: 3px; font-size: 12px; margin-right: 5px; margin-bottom: 5px;">
                #{{ tag }}
            </span>
            {% endfor %}
        </p>
        {% endif %}
        <p style="font-size: 13px; color: #999; margin: 5px 0;">
            🔗 <a href="{{ item.url }}" style="color: #1976d2; text-decoration: none;">查看原文</a>
            {% if item.rating %}| 推荐: {{ '⭐' * item.rating }}{% endif %}
        </p>
    </section>
    {% endfor %}
</section>
{% endif %}
{% endfor %}

<!-- 本周精选 -->
{% if highlights %}
<section style="margin: 25px 8px; padding: 15px; background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); border-radius: 8px; box-shadow: 0 3px 10px rgba(0,0,0,0.1);">
    <h2 style="font-size: 18px; color: white; margin: 0 0 12px 0;">
        🎨 本周精选
    </h2>
    <p style="font-size: 14px; color: white; margin-bottom: 10px;">
        本周最值得关注的内容：
    </p>
    {% for item in highlights %}
    <section style="margin-bottom: 12px; padding: 10px; background-color: rgba(255,255,255,0.95); border-radius: 5px;">
        <p style="font-size: 14px; color: #333; margin: 0; line-height: 1.6;">
            <strong>{{ loop.index }}. {{ item.title }}</strong><br>
            <span style="color: #666; font-size: 13px;">{{ item.summary }}</span><br>
            <span style="color: #ff9800; font-size: 13px;">{{ '⭐' * item.rating }}</span>
        </p>
    </section>
    {% endfor %}
</section>
{% endif %}

<!-- 编者按 -->
{% if editor_notes %}
<section style="margin: 25px 8px; padding: 15px; background-color: #f3e5f5; border-left: 4px solid #9c27b0; border-radius: 4px;">
    <h2 style="font-size: 18px; color: #2c3e50; margin: 0 0 10px 0;">
        💭 编者按
    </h2>
    <p style="font-size: 14px; color: #555; line-height: 1.8; margin: 0;">
        {{ editor_notes }}
    </p>
</section>
{% endif %}

<!-- 订阅信息 -->
<section style="margin: 25px 8px; padding: 15px; background-color: #e0f2f1; border-radius: 8px; text-align: center;">
    <p style="font-size: 14px; color: #555; line-height: 1.8; margin: 0;">
        {{ subscription_info | replace('\n', '<br>') }}
    </p>
</section>

<!-- 页脚 -->
<section style="margin: 20px 8px; text-align: center; color: #999; font-size: 12px; border-top: 1px solid #eee; padding-top: 15px;">
    <p style="margin: 0;">生成时间: {{ generated_at }}</p>
</section>

</section>
</body>
</html>
